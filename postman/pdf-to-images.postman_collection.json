{
  "info": {
    "_postman_id": "1a3df0c4-9296-4a6d-8d82-b26f2a5b6c01",
    "name": "PDF to Images API",
    "description": "Коллекция для проверки сервиса конвертации PDF в изображения.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Convert JSON (base64)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pdf_base64\": \"{{pdf_base64}}\",\n  \"output_format\": \"png\",\n  \"quality_dpi\": 300\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/convert",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "convert"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Has success payload', function () {",
              "  pm.expect(json.status).to.eql('success');",
              "  pm.expect(json.page_count).to.be.a('number');",
              "  pm.expect(json.pages).to.be.an('array');",
              "  pm.expect(json.request_id).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Convert Binary (multipart -> zip)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "pdf_file",
              "type": "file",
              "src": "{{pdf_file_path}}"
            },
            {
              "key": "output_format",
              "value": "png",
              "type": "text"
            },
            {
              "key": "quality_dpi",
              "value": "300",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/v1/convert/binary",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "convert",
            "binary"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is zip', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/zip');",
              "});",
              "",
              "pm.test('Has request id header', function () {",
              "  pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "pdf_base64",
      "value": "PASTE_BASE64_PDF_HERE"
    },
    {
      "key": "pdf_file_path",
      "value": "C:/path/to/sample.pdf"
    }
  ]
}
